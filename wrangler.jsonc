{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "deploy/edge/worker.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./deploy/edge/public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-production-db",
      "database_id": "ce4a313b-69c9-4fc6-8385-b45eeba064df"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHARED_CONFIG_KV",
      "id": "f8b3339a3f154b29bb794f7f32a654ed"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "UPSTREAM_API": "https://api.curavex.workers.dev"
  },
  "ratelimits": [
    {
      "name": "RL_FREE",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_STANDARD",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RL_ENTERPRISE",
      "namespace_id": "1003",
      "simple": { "limit": 1200, "period": 60 }
    }
  ]
}
